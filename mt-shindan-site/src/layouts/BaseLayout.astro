---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "山口県の中小企業診断士 前貴棋。AI活用支援・事業承継/M&A・補助金申請支援。" } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - 前貴棋中小企業診断士事務所</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@500&display=swap" />
  <style is:global>
    :root {
      --bg: #F6F4EE;
      --ink: #242B24;
      --moss: #3D5C45;
      --moss-light: #EDF1EA;
      --gold: #A97A3F;
      --gold-light: #F6EDDD;
      --coral: #B0503A;
      --line: #DAD5C6;
      --muted: #6B6656;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: 'Noto Sans JP', sans-serif;
      line-height: 1.8;
    }
    h1, h2, h3 {
      font-family: 'Shippori Mincho', serif;
      line-height: 1.5;
    }
    a { color: var(--moss); text-decoration: none; }
    a:hover { text-decoration: underline; }
    img { max-width: 100%; height: auto; border-radius: 8px; }
    .wrap { max-width: 880px; margin: 0 auto; padding: 0 24px; }

    /* Eyebrow section labels */
    .eyebrow { display: block; font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); margin: 0 0 8px; }

    /* Hero trust badges */
    .trust-badges { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 0; padding: 0; list-style: none; }
    .trust-badges li { display: inline-flex; align-items: center; background: var(--moss-light); color: var(--moss); border: 1px solid var(--line); padding: 6px 16px; border-radius: 999px; font-size: 12px; font-weight: 700; }

    /* Concerns checklist */
    .concerns-list { list-style: none; padding: 0; margin: 24px 0; display: flex; flex-direction: column; gap: 10px; }
    .concerns-list li { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 14px 18px; font-size: 15px; font-weight: 700; }

    /* Card grids (why-choose-us / services) */
    .card-grid { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: 24px; margin: 32px 0; padding: 0; list-style: none; }
    @media (max-width: 860px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } }
    .card { background: #fff; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
    .card-media { aspect-ratio: 4 / 3; overflow: hidden; background: var(--moss-light); }
    .card-media.is-3-2 { aspect-ratio: 3 / 2; }
    .card-media img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; margin: 0; display: block; }
    .card-body { padding: 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .card-num { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: var(--gold-light); color: var(--gold); font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; }
    .card-tag { display: inline-block; align-self: flex-start; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; color: var(--moss); background: var(--moss-light); padding: 3px 10px; border-radius: 999px; }
    .card-body h3 { font-size: 17px; margin: 0; font-family: 'Shippori Mincho', serif; }
    .card-body p { font-size: 14px; color: var(--muted); margin: 0; flex: 1; }
    .card-link { font-size: 13px; font-weight: 700; }

    /* How it works timeline */
    .timeline { list-style: none; padding: 0; margin: 32px 0; }
    .timeline li { display: flex; gap: 18px; align-items: flex-start; padding: 20px 0; border-bottom: 1px solid var(--line); }
    .timeline li:last-child { border-bottom: none; }
    .step-icon { width: 60px; height: 60px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: var(--moss-light); }
    .step-icon img { width: 100%; height: 100%; object-fit: cover; margin: 0; border-radius: 0; }
    .step-num { display: block; font-family: 'JetBrains Mono', monospace; color: var(--gold); font-weight: 700; font-size: 12px; margin-bottom: 4px; }
    .step-body h4 { margin: 0 0 4px; font-size: 16px; font-family: 'Shippori Mincho', serif; }
    .step-body p { margin: 0; font-size: 14px; color: var(--muted); }

    /* About stat row */
    .stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 28px 0; padding: 0; list-style: none; }
    @media (max-width: 640px) { .stat-row { grid-template-columns: repeat(2, 1fr); } }
    .stat-row li { text-align: center; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 8px; }
    .stat-row .stat-num { display: block; font-family: 'Shippori Mincho', serif; font-size: 26px; font-weight: 700; color: var(--moss); }
    .stat-row .stat-label { display: block; font-size: 12px; color: var(--muted); margin-top: 4px; }

    /* Credentials list */
    .credentials-list { list-style: none; padding: 0; margin: 24px 0; display: flex; flex-direction: column; gap: 10px; }
    .credentials-list li { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 14px 18px; }
    .credentials-list strong { display: block; font-size: 15px; }
    .credentials-list span { display: block; font-size: 13px; color: var(--muted); margin-top: 2px; }

    .site-header { border-bottom: 1px solid var(--line); background: #fff; position: sticky; top: 0; z-index: 50; }
    .header-inner { position: relative; display: flex; align-items: center; justify-content: space-between; padding-top: 16px; padding-bottom: 16px; }
    .logo { font-family: 'Shippori Mincho', serif; font-weight: 700; font-size: 18px; color: var(--ink); white-space: nowrap; }
    .site-nav { display: flex; align-items: center; gap: 20px; font-size: 14px; }
    .site-nav a { white-space: nowrap; }
    .nav-cta { background: var(--moss); color: #fff; padding: 8px 16px; border-radius: 999px; }
    .nav-cta:hover { text-decoration: none; opacity: 0.9; }
    .nav-toggle { display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px; width: 40px; height: 40px; background: none; border: none; cursor: pointer; padding: 0; flex-shrink: 0; }
    .nav-toggle span { display: block; width: 22px; height: 2px; background: var(--ink); transition: transform 0.2s ease, opacity 0.2s ease; }
    .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    @media (max-width: 640px) {
      .nav-toggle { display: flex; }
      .site-nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        background: #fff;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
      }
      .site-nav.is-open { display: flex; }
      .site-nav a { padding: 14px 24px; border-top: 1px solid var(--line); }
      .nav-cta { border-radius: 0; text-align: center; }
    }

    .site-footer { border-top: 1px solid var(--line); margin-top: 60px; padding: 40px 0 32px; font-size: 13px; color: var(--muted); }
    .footer-inner { display: flex; flex-wrap: wrap; gap: 24px 40px; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .footer-nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
    .footer-nav a { color: var(--muted); }
    .footer-social { display: flex; gap: 16px; }
    .footer-social a { color: var(--muted); }
    .footer-bottom { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 20px; font-size: 12px; }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="logo">前貴棋中小企業診断士事務所</a>
      <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="メニューを開く">
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav" class="site-nav">
        <a href="/">HOME</a>
        <a href="/blog/">ブログ</a>
        <a href="/yamaguchi-chushokigyo-shindan/">プロフィール</a>
        <a href="/contact/" class="nav-cta">お問い合わせ</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-inner">
        <nav class="footer-nav">
          <a href="/">HOME</a>
          <a href="/blog/">ブログ</a>
          <a href="/yamaguchi-chushokigyo-shindan/">プロフィール</a>
          <a href="/contact/">お問い合わせ</a>
          <a href="/privacy-policy/">プライバシーポリシー</a>
        </nav>
        <div class="footer-social">
          <a href="https://www.facebook.com/takakimae672" target="_blank" rel="noopener noreferrer">Facebook</a>
          <a href="https://www.instagram.com/takaki_mae/" target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>TEL: 080-6307-4502　｜　受付時間: 平日 9:00〜18:00</span>
        <span>Copyright &copy; 2023-2026 前貴棋中小企業診断士事務所 All Rights Reserved.</span>
      </div>
    </div>
  </footer>
  <script>
    const navToggle = document.getElementById("nav-toggle");
    const siteNav = document.getElementById("site-nav");
    navToggle?.addEventListener("click", () => {
      const isOpen = siteNav?.classList.toggle("is-open");
      navToggle.setAttribute("aria-expanded", String(!!isOpen));
    });
  </script>
</body>
</html>
