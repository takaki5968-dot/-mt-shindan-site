---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// Rendered by its own route rather than [slug].astro so the content can use
// full-bleed bands instead of a single .wrap column.
const pages = await getCollection("pages");
const entry = pages.find((p) => p.data.slug === "ai-support")!;
const { Content } = await render(entry);

// Mirrors the FAQ rendered on this page (src/content/pages/ai-support.md).
// Keep both in sync — the markup has to match the visible answers.
const faqs = [
  {
    q: "パソコンが苦手でも大丈夫ですか？",
    a: "大丈夫です。御社のパソコンを一緒に触りながら進めるので、操作の手順もその場で確認できます。分からないことを分からないまま先に進めない、というのを前提にしています。",
  },
  {
    q: "棚卸しだけでもお願いできますか？",
    a: "できます。3時間・3万円（税別）です。棚卸し表をお渡しして、そこで終わりにしていただいて構いません。続けるかどうかは、表を見てから決めてください。",
  },
  {
    q: "一人でやっている店でも頼めますか？",
    a: "頼めます。主に想定しているのは従業員5名から30名くらいの会社ですが、棚卸しは人数に関係なく行えます。月額の伴走が見合うかどうかは、棚卸しの結果を見て一緒に判断します。",
  },
  {
    q: "結局、有料のツールを買わされませんか？",
    a: "当事務所はツールの販売代理店ではなく、紹介手数料も受け取らないため、特定の製品を勧める理由がありません。無料で使える範囲で足りる場合は、そのようにお伝えします。有料版が必要な場面もありますが、その判断は費用対効果を一緒に確認したうえで、事業者ご自身に決めていただきます。",
  },
  {
    q: "社内の情報をAIに入れても大丈夫ですか？",
    a: "入れてよい情報と、入れてはいけない情報があります。顧客の個人情報や取引先との機密は、慎重に扱う必要があります。どこまで入れてよいかの線引きを、最初に一緒に決めます。御社の情報を、無断で外部のサービスに入れることはありません。",
  },
  {
    q: "補助金は使えますか？",
    a: "ソフトを入れる場合は、デジタル化・AI導入補助金の対象になることがあります。ただし対象は事務局に登録されたITツールに限られます。当事務所はIT導入支援事業者ではないため、この伴走の費用そのものは補助の対象になりません。",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: "https://mt-shindan.com/" },
    { "@type": "ListItem", position: 2, name: "AI導入支援", item: "https://mt-shindan.com/ai-support/" },
  ],
};
---
<BaseLayout
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <article class="prose">
    <Content />
  </article>
</BaseLayout>

<style>
  .prose :global(h1) { font-size: 32px; margin-top: 0; }
  /* Section headings were 24px against a 32px H1, so past the first screen
     the page had almost no scale contrast. A reader described it as "flowing
     past". These are the only chapter markers on a 8,000px page. */
  .prose :global(h2) { font-size: clamp(26px, 3.2vw, 32px); margin-top: 0; border-left: 4px solid var(--gold-rule); padding-left: 14px; }
  .prose :global(.band > .wrap > *:first-child) { margin-top: 0; }
  .prose :global(ul) { padding-left: 20px; }
</style>
