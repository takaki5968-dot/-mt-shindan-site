---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { slug: p.data.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const byNewest = (a: any, b: any) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime();

const allPosts = (await getCollection("blog")).sort(byNewest);
const currentIndex = allPosts.findIndex((p) => p.data.slug === entry.data.slug);
const newer = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const older =
  currentIndex >= 0 && currentIndex < allPosts.length - 1
    ? allPosts[currentIndex + 1]
    : null;

const currentCategory = entry.data.categories?.[0] ?? "";

// Same category first — that is the strongest signal of "more like this" —
// then fall back to recent posts so there are always three to move on to.
const sameCategory = allPosts.filter(
  (p) => p.data.slug !== entry.data.slug && p.data.categories?.[0] === currentCategory
);
const otherPosts = allPosts.filter(
  (p) => p.data.slug !== entry.data.slug && p.data.categories?.[0] !== currentCategory
);
const related = [...sameCategory, ...otherPosts].slice(0, 3);

// Rough reading time from the raw markdown. Japanese reads at roughly
// 500 characters a minute; markup is stripped so it isn't counted.
function readingMinutes(body: string | undefined): number {
  if (!body) return 1;
  const text = body
    .replace(/```[\s\S]*?```/g, "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/<[^>]+>/g, "")
    .replace(/[#*>|_`-]/g, "")
    .replace(/\s+/g, "");
  return Math.max(1, Math.round(text.length / 500));
}
const minutes = readingMinutes(entry.body);

// Which service to point a reader at, based on the post's category.
// Posts in personal categories (事務所より / 読書) get the generic invitation.
const SERVICE_BY_CATEGORY: Record<
  string,
  { href: string; name: string; pitch: string }
> = {
  補助金: {
    href: "/subsidy-support/",
    name: "補助金申請支援",
    pitch:
      "持続化補助金・ものづくり補助金など、事業に合った制度の選定から事業計画書の作成、申請手続きまでサポートします。",
  },
  "セミナー・登壇": {
    href: "/seminar/",
    name: "セミナー・研修講師",
    pitch:
      "商工会・商工会議所や事業者団体からのご依頼を承っています。テーマ・対象者・時間に合わせてご提案します。",
  },
  経営のヒント: {
    href: "/marketing-support/",
    name: "マーケティング支援",
    pitch:
      "「誰に・何を・どう伝えるか」を整理し、売上と集客につながる仕組みを一緒に作ります。SNS・生成AIの活用にも対応します。",
  },
  お知らせ: {
    href: "/yamaguchi-chushokigyo-shindan/",
    name: "プロフィール",
    pitch:
      "商工会経営指導員として9年、独立後も継続して、通算12年以上にわたり地域の事業者と向き合ってきました。これまでの経歴と支援方針をご覧いただけます。",
  },
};

const DEFAULT_SERVICE = {
  href: "/business-plan/",
  name: "経営計画策定支援",
  pitch:
    "現状の整理から数値計画づくりまで、「経営の羅針盤」となる事業計画を対話しながら一緒に作ります。",
};

const AI_SERVICE = {
  href: "/ai-support/",
  name: "AI導入支援",
  pitch:
    "「うちの何に使えるか」の見極めから、業務に定着するまで伴走します。ツールを売る立場ではないので、無料の範囲で足りるならそうお伝えします。",
};

const category = entry.data.categories?.[0] ?? "";

// A post about AI should offer the AI page, whatever category it sits in.
const isAboutAI = /生成AI|ChatGPT|AI活用|AIで|AIパスポート/.test(
  `${entry.data.title} ${entry.data.description ?? ""}`
);

const service = isAboutAI
  ? AI_SERVICE
  : SERVICE_BY_CATEGORY[category] ?? DEFAULT_SERVICE;
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  seoTitle={entry.data.seoTitle}
  ogType="article"
>
  <div class="wrap" style="padding:40px 0 60px; max-width:760px;">
    <div class="post-meta">
      {new Date(entry.data.date).toLocaleDateString("ja-JP")}
      {entry.data.categories?.length ? ` ・ ${entry.data.categories.join(", ")}` : ""}
      {` ・ 約${minutes}分で読めます`}
    </div>
    <h1 style="margin-top:8px;">{entry.data.title}</h1>
    <article class="prose">
      <Content />
    </article>

    {(newer || older) && (
      <nav class="post-nav" aria-label="前後の記事">
        {older ? (
          <a class="post-nav-item is-prev" href={`/blog/${older.data.slug}/`}>
            <span class="post-nav-dir">← 前の記事</span>
            <span class="post-nav-title">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer ? (
          <a class="post-nav-item is-next" href={`/blog/${newer.data.slug}/`}>
            <span class="post-nav-dir">次の記事 →</span>
            <span class="post-nav-title">{newer.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}

    {related.length > 0 && (
      <section class="related" aria-label="関連記事">
        <div class="related-head">
          <div>
            <p class="related-eyebrow">Related</p>
            <h2>あわせて読みたい記事</h2>
          </div>
          {currentCategory && (
            <a class="related-more" href={`/blog/#${encodeURIComponent(currentCategory)}`}>
              「{currentCategory}」の記事をすべて見る →
            </a>
          )}
        </div>
        <div class="related-grid">
          {related.map((post) => (
            <a class="related-card" href={`/blog/${post.data.slug}/`}>
              <span class="related-meta">
                {new Date(post.data.date).toLocaleDateString("ja-JP")}
                {post.data.categories?.length ? ` ・ ${post.data.categories[0]}` : ""}
              </span>
              <span class="related-title">{post.data.title}</span>
              {post.data.description && (
                <span class="related-excerpt">{post.data.description}</span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <aside class="post-cta">
      <p class="post-cta-eyebrow">関連するサービス</p>
      <h2>{service.name}</h2>
      <p class="post-cta-pitch">{service.pitch}</p>
      <div class="post-cta-actions">
        <a class="btn-primary" href="/contact/">無料相談を申し込む →</a>
        <a class="btn-ghost" href={service.href}>{service.name}を見る</a>
      </div>
      <p class="post-cta-note">初回30分のご相談は無料です。営業目的のご連絡は行いません。</p>
    </aside>

    <div style="margin-top:32px;">
      <a href="/blog/">← ブログ一覧に戻る</a>
    </div>
  </div>
</BaseLayout>

<style>
  .post-meta { font-size: 12px; color: var(--muted); font-family: 'JetBrains Mono', monospace; }

  /* Previous / next */
  .post-nav {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--line);
  }
  @media (max-width: 620px) { .post-nav { grid-template-columns: 1fr; } }
  .post-nav-item {
    display: flex; flex-direction: column; gap: 5px;
    background: #fff; border: 1px solid var(--line); border-radius: 10px;
    padding: 14px 16px; min-width: 0;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .post-nav-item:hover { border-color: var(--moss); text-decoration: none; transform: translateY(-2px); }
  .post-nav-item.is-next { text-align: right; }
  .post-nav-dir { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--gold); font-weight: 600; }
  .post-nav-title {
    font-size: 13.5px; font-weight: 700; color: var(--ink); line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Related posts */
  .related { margin-top: 44px; }
  .related-head {
    display: flex; flex-wrap: wrap; gap: 8px 20px;
    align-items: flex-end; justify-content: space-between; margin-bottom: 18px;
  }
  .related-eyebrow {
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); margin: 0 0 4px;
  }
  .related h2 { font-size: 20px; margin: 0; border: none; padding: 0; }
  .related-more { font-size: 13px; font-weight: 700; white-space: nowrap; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  @media (max-width: 760px) { .related-grid { grid-template-columns: 1fr; } }
  .related-card {
    display: flex; flex-direction: column; gap: 5px; min-width: 0;
    background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .related-card:hover {
    border-color: var(--moss); text-decoration: none;
    transform: translateY(-3px); box-shadow: var(--shadow-md);
  }
  .related-meta { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--muted); }
  .related-title {
    font-size: 14.5px; font-weight: 700; color: var(--ink); line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .related-excerpt {
    font-size: 12.5px; color: var(--muted); line-height: 1.7;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .prose :global(h2) { font-size: 22px; margin-top: 32px; border-left: 4px solid var(--gold-rule); padding-left: 12px; }
  .prose :global(a) { color: var(--moss); font-weight: 600; }

  .post-cta {
    margin-top: 48px;
    background: var(--moss-light);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 26px 28px;
  }
  .post-cta-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 8px;
  }
  .post-cta h2 {
    font-size: 20px;
    margin: 0 0 10px;
    border: none;
    padding: 0;
  }
  .post-cta-pitch { font-size: 14px; color: var(--muted); margin: 0 0 18px; }
  .post-cta-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn-primary,
  .btn-ghost {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 11px 22px; border-radius: 999px;
    font-size: 14px; font-weight: 700; white-space: nowrap;
  }
  .btn-primary { background: var(--moss); color: #fff; }
  .btn-ghost { background: #fff; color: var(--moss); border: 1px solid var(--moss); }
  .btn-primary:hover, .btn-ghost:hover { text-decoration: none; opacity: 0.9; }
  .post-cta-note { font-size: 12px; color: var(--muted); margin: 14px 0 0; }
</style>
