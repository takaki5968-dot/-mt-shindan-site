---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { slug: p.data.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="wrap" style="padding:40px 0 60px; max-width:760px;">
    <div style="font-size:12px; color:var(--muted); font-family:'JetBrains Mono',monospace;">
      {new Date(entry.data.date).toLocaleDateString("ja-JP")}
      {entry.data.categories?.length ? ` ・ ${entry.data.categories.join(", ")}` : ""}
    </div>
    <h1 style="margin-top:8px;">{entry.data.title}</h1>
    <article class="prose">
      <Content />
    </article>
    <div style="margin-top:40px;">
      <a href="/blog/">← ブログ一覧に戻る</a>
    </div>
  </div>
</BaseLayout>

<style>
  .prose :global(h2) { font-size: 22px; margin-top: 32px; border-left: 4px solid var(--gold); padding-left: 12px; }
  .prose :global(a) { color: var(--moss); font-weight: 600; }
</style>
